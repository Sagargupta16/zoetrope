__pycache__/
*.pyc
.ruff_cache/
# envs.py builds a working folder's .venv; never one in the skill's engine/, which cp -r would copy everywhere
.venv/

# Every video and its working folder lives under outputs/, which is never committed
outputs/
frames/
review/
*.mp4
*.webm
*.gif
*.wav
*.mp3
*.raw
proof.png

# The one exception: the README's promo, made with the skill, and its GIF preview
!docs/*.mp4
!docs/*.gif
