  "cards": [
    {
      "dot": "amber",
      "title": "Review loops",
      "items": [
        "REVIEW FIX at either stage goes back to the builder as one numbered list",
        "3 rounds for a FIX row, 2 for a note, then the open items go to you",
        "Any change after approval: qa.py diff --expect, then a fresh review"
      ]
    },
    {
      "dot": "cyan",
      "title": "Shared contract (engine/contract.py)",
      "items": [
        "One frame clock, frame_of, for every module",
        "Row: PASS, FIX, NOTE, NOT CHECKED (exit 2)",
        "60 Q codes, each with its owner module",
        "Ctx decodes the file once for every gate"
      ]
    },
    {
      "dot": "violet",
      "title": "What a build writes",
      "items": [
        "video.mp4: frames piped into ffmpeg through shared memory",
        "frames.hash, thumbs.npy: one digest and thumb per frame",
        "mix_raw.wav, sfx.wav, cuesheet.json: stems and cue sheet",
        "approved/: hashes the reviewer passed"
      ]
    },
    {
      "dot": "emerald",
      "title": "Proved by",
      "items": [
        "qa.py selftest: 161 planted faults cover all 60 codes",
        "Template smoke at 1920x1080 and 1080x1920"
      ]
    }
  ]
